{% render 'partials/head.liquid', title: 'Squad page' %}

<header>

  <div class="banner">
  <img class="header-foto" src="/assets/images/header-foto.png" alt="header-foto" width=2000>
  </div>

  <div class="overlay">
    <p><a href="/index1i">Squad 1I</a> </p>
    <h1><a href="/">Squad 1J</a> </h1>
  </div>
</header>

<main>

  <nav class="buttons">
    <ul>
      <li><a href="/favorietseizoen" class="favoriet-seizoen">Favoriet seizoen</a></li>
      <li><a href="/favorietedier" class="favoriete-dier">Favoriete dier</a></li>
      <li><a href="/verjaardag" class="verjaardag">Verjaardag</a></li>
      <li><a href="/bijnaam" class="bijnaam">Bijnaam</a></li>
    </ul>
  </nav>

  <div class="dieren-emojis">
    <a href="/favorietedier/Aap">🐵</a>
    <a href="/favorietedier/Flamingo">🦩</a>
    <a href="/favorietedier/Giraffe">🦒</a>
    <a href="/favorietedier/Hond">🐶</a>
    <a href="/favorietedier/Kat">🐱</a>
    <a href="/favorietedier/Koala">🐨</a>
    <a href="/favorietedier/Konijn">🐰</a>
    <a href="/favorietedier/Leeuw">🦁</a>
    <a href="/favorietedier/Neushoorn">🦏</a>
    <a href="/favorietedier/Nuilpaard">🦛</a>
    <a href="/favorietedier/Olifant">🐘</a>
    <a href="/favorietedier/Panda">🐼</a>
    <a href="/favorietedier/Papegaai">🦜</a>
    <a href="/favorietedier/Pinguin">🐧</a>
    <a href="/favorietedier/Tijger">🐯</a>
    <a href="/favorietedier/Vos">🦊</a>
    <a href="/favorietedier/Zebra">🦓</a>
  </div>


  <article class="mugshots">
    {% for person in persons %}

      <figure class="polaroid">
        {% comment %} if is de eerste foto die hij pakt en als die niet bestaat pakt hij de else foto {% endcomment %}
        {% if person.mugshot %}
            <img src="https://fdnd.directus.app/assets/{{ person.mugshot }}?width=500" alt="Profile picture">
        {% else %}
            <img src="/assets/images/else-foto.jpg" width=500 alt="Profile picture">
        {% endif %}

        {% comment %} if is de eerste tekst die hij pakt en als die niet bestaat pakt hij de else tekst {% endcomment %}
        {% if person.fav_animal %}
            <h2>{{ person.fav_animal }}</h2>
        {% else %}
            <h2>?</h2>
        {% endif %}
      </figure>
      
    {% endfor %}   
  </article>

</main>

{% render 'partials/foot.liquid', squads: squads %}